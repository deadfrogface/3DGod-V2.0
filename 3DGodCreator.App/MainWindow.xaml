<Window x:Class="ThreeDGodCreator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="3D God Creator" Height="900" Width="1600"
        MinHeight="480" MinWidth="800"
        Background="#1e1e1e" Focusable="True" Loaded="Window_Loaded">
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#2d2d2d" Foreground="White">
            <MenuItem x:Name="MenuFile" Header="File">
                <MenuItem x:Name="MenuFileNew" Header="New" Click="MenuNewProject_Click"/>
                <MenuItem x:Name="MenuFileOpen" Header="Open…" Click="MenuOpenProject_Click"/>
                <MenuItem x:Name="MenuFileSave" Header="Save as…" Click="MenuSaveProject_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuFileAnny" Header="Generate Anny Human" Click="MenuAnnyGenerate_Click"/>
                <MenuItem x:Name="MenuFileExportGlb" Header="Export GLB…" Click="MenuExportGlb_Click"/>
            </MenuItem>
            <MenuItem x:Name="MenuEdit" Header="Edit">
                <MenuItem x:Name="MenuEditUndo" Header="Undo" Command="Undo"/>
                <MenuItem x:Name="MenuEditRedo" Header="Redo" Command="Redo"/>
            </MenuItem>
            <MenuItem x:Name="MenuTools" Header="Tools">
                <MenuItem x:Name="MenuSetupAssistant" Header="Setup Assistant / Components…" Click="MenuSetupAssistant_Click"/>
            </MenuItem>
        </Menu>
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="300"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="2*" MinWidth="400"/>
        </Grid.ColumnDefinitions>
        <TabControl x:Name="Tabs" Grid.Row="0" Grid.Column="0" Background="#2d2d2d" BorderThickness="0">
            <TabItem x:Name="TabCharacter" Header="Character">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="CHARACTER CREATOR" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="Human, humanoid creature or freeform character. Manual controls and AI edit the same project state."
                                   Foreground="#aaa" TextWrapping="Wrap" Margin="0,6,0,16"/>
                        <TextBlock Text="Base" Foreground="#ddd" FontWeight="SemiBold"/>
                        <UniformGrid Columns="3" Margin="0,6,0,14">
                            <Button x:Name="BtnCharacterHuman" Content="Human" Margin="2" Padding="8" Click="CharacterHuman_Click"/>
                            <Button x:Name="BtnCharacterOrc" Content="Orc" Margin="2" Padding="8" Click="CharacterOrc_Click"/>
                            <Button x:Name="BtnCharacterRat" Content="Rat" Margin="2" Padding="8" Click="CharacterRat_Click"/>
                        </UniformGrid>
                        <TextBlock Text="Body / face" Foreground="#ddd" FontWeight="SemiBold"/>
                        <TextBlock Text="These controls write to the authoritative Anny state; regeneration uses the same values."
                                   Foreground="#888" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,8"/>
                        <TextBlock Text="Muscle" Foreground="White"/>
                        <Slider x:Name="CreatorMuscle" Minimum="0" Maximum="1" Value="0.5" TickFrequency="0.05" ValueChanged="CreatorMorph_ValueChanged" Tag="muscle"/>
                        <TextBlock Text="Weight" Foreground="White" Margin="0,8,0,0"/>
                        <Slider x:Name="CreatorWeight" Minimum="0" Maximum="1" Value="0.5" TickFrequency="0.05" ValueChanged="CreatorMorph_ValueChanged" Tag="weight"/>
                        <TextBlock Text="Jaw width" Foreground="White" Margin="0,8,0,0"/>
                        <Slider x:Name="CreatorJaw" Minimum="-1" Maximum="1" Value="0" TickFrequency="0.05" ValueChanged="CreatorMorph_ValueChanged" Tag="jaw_width"/>
                        <TextBlock Text="Brow ridge" Foreground="White" Margin="0,8,0,0"/>
                        <Slider x:Name="CreatorBrow" Minimum="-1" Maximum="1" Value="0" TickFrequency="0.05" ValueChanged="CreatorMorph_ValueChanged" Tag="brow_ridge"/>
                        <TextBlock Text="Nose width" Foreground="White" Margin="0,8,0,0"/>
                        <Slider x:Name="CreatorNose" Minimum="-1" Maximum="1" Value="0" TickFrequency="0.05" ValueChanged="CreatorMorph_ValueChanged" Tag="nose_width"/>
                        <Button x:Name="BtnCreatorRegenerate" Content="Apply / Regenerate Character" Margin="0,16,0,4" Padding="10" Click="CharacterRegenerate_Click"/>
                        <TextBlock x:Name="CreatorStatus" Text="Ready" Foreground="#f0c14b" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="TabAnny" Header="Anny">
                <ContentControl x:Name="AnnyPanel"/>
            </TabItem>
            <TabItem x:Name="TabForm" Header="Form">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ContentControl x:Name="FormPanel"/>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="TabSculpt" Header="Sculpt">
                <ContentControl x:Name="SculptPanel"/>
            </TabItem>
            <TabItem x:Name="TabNsfw" Header="NSFW">
                <ContentControl x:Name="NsfwPanel"/>
            </TabItem>
            <TabItem x:Name="TabClothing" Header="Clothing">
                <ContentControl x:Name="ClothingPanel"/>
            </TabItem>
            <TabItem x:Name="TabPhysics" Header="Physics">
                <ContentControl x:Name="PhysicsPanel"/>
            </TabItem>
            <TabItem x:Name="TabMaterial" Header="Material">
                <ContentControl x:Name="MaterialPanel"/>
            </TabItem>
            <TabItem x:Name="TabPresets" Header="Presets">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ContentControl x:Name="PresetPanel"/>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="TabRigging" Header="Rigging">
                <ContentControl x:Name="RiggingPanel"/>
            </TabItem>
            <TabItem x:Name="TabExport" Header="Export">
                <ContentControl x:Name="ExportPanel"/>
            </TabItem>
            <TabItem x:Name="TabSettings" Header="Settings">
                <ContentControl x:Name="SettingsPanel"/>
            </TabItem>
            <TabItem x:Name="TabAi" Header="AI">
                <ContentControl x:Name="AiPanel"/>
            </TabItem>
            <TabItem x:Name="TabProblems" Header="Problems">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ContentControl x:Name="ProblemsPanel"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <GridSplitter Grid.Row="0" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#404040"/>
        <Border Grid.Row="0" Grid.Column="2" Background="#252526" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="PreviewTitle" Grid.Row="0" Text="3D Preview" FontSize="16" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <StackPanel Grid.Row="1" Margin="0,0,0,6">
                    <TextBlock x:Name="PreviewControls" Text="Right-click drag = Rotate · Shift+Right-click = Pan · Mouse wheel = Zoom · Left-click = Select"
                               Foreground="#888" FontSize="11"/>
                    <TextBlock x:Name="SelectionInfo" Text="Selection: (none)" Foreground="#f0c14b" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Row="2" x:Name="ViewportHost" Background="#1a1a1a" MinHeight="300">
                    <Image x:Name="PreviewImage" Stretch="Uniform"/>
                </Border>
            </Grid>
        </Border>
        <Border x:Name="DebugPanelHost" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Background="#252526" Visibility="Collapsed"
                MaxHeight="300" MinHeight="150">
            <ContentControl x:Name="DebugConsoleHost"/>
        </Border>
    </Grid>
    </DockPanel>
</Window>
