<Window x:Class="ThreeDGodCreator.App.Windows.SetupAssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="3D God Setup Assistant"
        Height="560" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="#1e1e1e"
        Foreground="White">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="BtnSkip" Content="Skip setup and open 3D God" Padding="12,6" Margin="0,0,8,0" Click="BtnSkip_Click"/>
      <Button x:Name="BtnRefresh" Content="Refresh" Padding="12,6" Margin="0,0,8,0" Click="BtnRefresh_Click"/>
      <Button x:Name="BtnClose" Content="Close" Padding="12,6" Click="BtnClose_Click"/>
    </StackPanel>
    <StackPanel>
      <TextBlock Text="Optional components" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4"/>
      <TextBlock TextWrapping="Wrap" Foreground="#bbbbbb" Margin="0,0,0,12"
                 Text="Install only what you need. Failures here never block the core app. Advanced backend names stay hidden unless you expand a row."/>
      <CheckBox x:Name="ChkAdvanced" Content="Show advanced backend names" Foreground="White" Margin="0,0,0,8" Checked="ChkAdvanced_Changed" Unchecked="ChkAdvanced_Changed"/>
      <ListBox x:Name="FeatureList" Background="#2d2d2d" BorderThickness="0" Height="360">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Padding="8" Margin="0,0,0,6" Background="#333333">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="#cccccc"/>
                  <TextBlock Text="{Binding StateLine}" Foreground="#f0c14b" Margin="0,4,0,0"/>
                  <TextBlock Text="{Binding AdvancedLine}" Foreground="#888888" Visibility="{Binding AdvancedVisibility}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Vertical">
                  <Button Content="Install" Margin="0,0,0,4" Padding="10,4" IsEnabled="{Binding CanInstall}"
                          Tag="{Binding ComponentId}" Click="BtnInstall_Click"/>
                  <Button Content="Repair" Margin="0,0,0,4" Padding="10,4" IsEnabled="{Binding CanRepair}"
                          Tag="{Binding ComponentId}" Click="BtnRepair_Click"/>
                  <Button Content="Remove" Margin="0,0,0,4" Padding="10,4" IsEnabled="{Binding CanRemove}"
                          Tag="{Binding ComponentId}" Click="BtnRemove_Click"/>
                  <Button Content="Diagnostics" Padding="10,4"
                          Tag="{Binding ComponentId}" Click="BtnDiagnostics_Click"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="LblStatus" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#9cdcfe"/>
    </StackPanel>
  </DockPanel>
</Window>
