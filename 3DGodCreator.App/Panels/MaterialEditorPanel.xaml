<UserControl x:Class="ThreeDGodCreator.App.Panels.MaterialEditorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="8">
        <TextBlock Text="Materialeditor" FontSize="16" Foreground="White" Margin="0,0,0,4"/>
        <TextBlock Text="Katalog-PBR (kein KI-Text-to-PBR). Viewport + GLB." Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBlock Text="Material-Slot:" Foreground="Gray" Margin="0,0,0,2"/>
        <ComboBox x:Name="CmbMaterial" Margin="0,0,0,8" SelectionChanged="CmbMaterial_SelectionChanged">
            <ComboBoxItem Content="skin"/>
            <ComboBoxItem Content="clothes"/>
            <ComboBoxItem Content="piercings"/>
            <ComboBoxItem Content="tattoos"/>
        </ComboBox>
        <TextBlock Text="Katalog-Preset:" Foreground="Gray" Margin="0,0,0,2"/>
        <ComboBox x:Name="CmbPreset" Margin="0,0,0,8" SelectionChanged="CmbPreset_SelectionChanged">
            <ComboBoxItem Content="Gold"/>
            <ComboBoxItem Content="Silver"/>
            <ComboBoxItem Content="Steel"/>
            <ComboBoxItem Content="Leather"/>
            <ComboBoxItem Content="Cloth"/>
            <ComboBoxItem Content="Plastic"/>
            <ComboBoxItem Content="Skin"/>
        </ComboBox>
        <TextBlock Text="Metallic" Foreground="Gray"/>
        <Slider x:Name="SldMetallic" Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>
        <TextBlock Text="Roughness" Foreground="Gray" Margin="0,4,0,0"/>
        <Slider x:Name="SldRoughness" Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>
        <Button Content="Farbe wählen" Padding="12,6" Margin="0,8,0,4" Click="BtnColor_Click"/>
        <Button Content="Auf Preview anwenden" Padding="12,6" Click="BtnApply_Click"/>
    </StackPanel>
</UserControl>
